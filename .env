# jo_sim settings (read by compose.yaml). Nothing secret lives here.

# Build options (need `docker compose build` to take effect)
BUILD_RTABMAP=false        # true: build RTAB-Map from source (slow, ~memory hungry); needed for visodom/vslam
GLIM_ROS_REF=dev           # mlisi1/glim_ros2 branch/tag/commit baked into the image
GLIM_ROS_COMMIT=da3fae12d91f1d133bb453f8e769712c7873b7a1  # optional glim_ros2 commit on top (rebuilds only glim_ros); empty = GLIM_ROS_REF
DENDROS_VERSION=latest     # DendROS release tag, or latest
BUILD_JOBS=8
CUDA_ARCHS=all-major     # gtsam_points CUDA archs; e.g. 120 for RTX 50xx only (faster build)

# Extra workspace packages rebuilt at container start, e.g. glim_ros when
# ~/glim_ros2 is mounted for development (see compose.yaml)
EXTRA_BUILD_PACKAGES=

ROS_DOMAIN_ID=0

# Gazebo transport partition. With network_mode: host every container on this machine shares the
# default partition (hostname:user), so two simulators would see each other's topics and clocks.
GZ_PARTITION=jo_sim
