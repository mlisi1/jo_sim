#!/usr/bin/env python3
"""List the worlds jo_sim can load by name (world:=<name>), with the result of check_worlds."""
import json
import os

from jo_sim.world_tools import STATUS_FILE, list_worlds, search_dirs

try:
    with open(STATUS_FILE) as f:
        status = json.load(f)
except (OSError, ValueError):
    status = {}

worlds = list_worlds()
dirs = search_dirs()


def home(path):
    # most specific search directory (the external collection is inside share/jo_sim/worlds)
    return max((d for d in dirs if path.startswith(d + os.sep)), key=len, default=None)


for d in dirs:
    names = sorted(n for n, p in worlds.items() if home(p) == d)
    if names:
        print(f'\n{d}')
        for n in names:
            s = status.get(n)
            if s:
                rtf = f"rtf {s['rtf']:.2f}" if s.get('rtf') is not None else ''
                print(f"  {n:28s} {s['verdict']:9s} {rtf}")
            else:
                print(f'  {n}')
print(f'\n{len(worlds)} worlds. Launch with: sim world:=<name>')
if not status:
    print('Run `ros2 run jo_sim check_worlds` to test which ones work in Gazebo Harmonic.')
